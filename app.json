{
  "expo": {
    "name": "lore-llm",
    "slug": "lore-llm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lore-llm-logo.png",
    "scheme": "lorellm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/lore-llm.icon",
      "bundleIdentifier": "it.lore.llm",
      "buildNumber": "4",
      "appleTeamId": "ZVCQ7Q6256"
    },
    "android": {
      "package": "com.davide.lorellm",
      "adaptiveIcon": {
        "backgroundColor": "#6A0DAD",
        "foregroundImage": "./assets/images/lore-1c-glyph-combined.png",
        "monochromeImage": "./assets/images/lore-1c-glyph-combined.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1920",
          "image": "./assets/images/lore-1c-glyph-combined.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "./plugins/with-scene-delegate"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
