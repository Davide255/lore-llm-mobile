# Live updates (OTA) upload over FTP(S), used by `npm run ota:publish -- --upload`
# (see docs/OTA.md). OTA_FTP_URL is the "ota/lore/mobile" folder on the server.
# Set OTA_FTP_TLS=0 only if the host has no FTPS.
OTA_FTP_URL=ftp://ftp.athly.it/public_html/ota/lore/mobile
OTA_FTP_USER=
OTA_FTP_PASSWORD=
OTA_FTP_TLS=1
# Private key that signs the manifests (default: ~/.lore-llm-ota/mobile/private-key.pem)
OTA_PRIVATE_KEY_PATH=
